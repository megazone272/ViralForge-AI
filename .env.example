# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/viralforge"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
WEB_ORIGIN="http://localhost:5173"
STORAGE_DIR="./storage"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# ── AI Provider (choose one) ──────────────────────────────────────────────────
# Set AI_PROVIDER=huggingface (default) | openai | local
AI_PROVIDER=huggingface

# HuggingFace — free tier, preferred
HF_TOKEN=""
HF_TEXT_MODEL="mistralai/Mistral-7B-Instruct-v0.3"
HF_IMAGE_MODEL="stabilityai/stable-diffusion-xl-base-1.0"

# OpenAI — fallback if HF not configured
OPENAI_API_KEY=""
OPENAI_TEXT_MODEL="gpt-4o-mini"
OPENAI_IMAGE_MODEL="dall-e-3"

# ── Piper TTS ─────────────────────────────────────────────────────────────────
# Auto-detected from piper/ directory. Override if needed:
# PIPER_EXE="./piper/piper.exe"
# PIPER_MODEL="en_US-lessac-medium"

# ── Whisper ───────────────────────────────────────────────────────────────────
# Model size: tiny | base | small | medium | large (larger = slower + better)
WHISPER_MODEL=base

# ── FFmpeg ────────────────────────────────────────────────────────────────────
# Auto-detected (system PATH → bin/ffmpeg.exe). Override:
# FFMPEG_PATH="./bin/ffmpeg.exe"

# ── OAuth — Publishing ────────────────────────────────────────────────────────
# YouTube (Google Cloud Console → OAuth 2.0 credentials)
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:4000/auth/youtube/callback"

# TikTok (TikTok for Developers → app credentials)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:4000/auth/tiktok/callback"

# Instagram + Facebook (Meta for Developers → app)
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:4000/auth/meta/callback"
