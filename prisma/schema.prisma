generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String?
  creditBalance Int      @default(100)
  createdAt     DateTime @default(now())
  projects      Project[]
  accounts      SocialAccount[]
}

model Project {
  id          String    @id @default(cuid())
  userId      String
  title       String
  prompt      String
  language    String    @default("English")
  durationSec Int       @default(45)
  style       String    @default("Viral Documentary")
  platform    String    @default("YouTube")
  tone        String    @default("Engaging")
  status      String    @default("QUEUED")
  script      String?
  metadata    String?
  videoPath   String?
  thumbnailPath String?
  srtPath     String?
  vttPath     String?
  errorMsg    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenes      Scene[]
  publishes   PublishJob[]
  analytics   AnalyticsSnapshot[]
}

model Scene {
  id           String   @id @default(cuid())
  projectId    String
  order        Int
  narration    String
  visualPrompt String
  imagePath    String?
  audioPath    String?
  srtPath      String?
  durationSec  Float    @default(5)
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model SocialAccount {
  id            String    @id @default(cuid())
  userId        String
  platform      String
  accountName   String
  accessToken   String
  refreshToken  String?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishes     PublishJob[]
  @@unique([userId, platform])
}

model PublishJob {
  id          String        @id @default(cuid())
  projectId   String
  accountId   String?
  platform    String
  status      String        @default("DRAFT")
  scheduledAt DateTime?
  title       String?
  caption     String?
  hashtags    String?
  remoteId    String?
  error       String?
  attempts    Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  account     SocialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
}

model AnalyticsSnapshot {
  id         String   @id @default(cuid())
  projectId  String
  platform   String
  views      Int      @default(0)
  likes      Int      @default(0)
  comments   Int      @default(0)
  shares     Int      @default(0)
  retention  Float?
  watchTime  Float?
  followers  Int      @default(0)
  capturedAt DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  reason      String
  createdAt   DateTime @default(now())
}